# Copy to .env and fill in. .env is gitignored -- never commit real values.

# --- Database (docker-compose db service + Django DATABASE_URL) ---
POSTGRES_DB=carmaintenance
POSTGRES_USER=carmaintenance
POSTGRES_PASSWORD=carmaintenance
# DATABASE_URL is assembled from the above by docker-compose.yml. Only set it
# directly if you're running Django outside docker (e.g. against localhost:5432).
# DATABASE_URL=postgres://carmaintenance:carmaintenance@localhost:5432/carmaintenance

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=*

# --- Embeddings (Case KB / RAG, Agent 4 gate) ---
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- LLM access: OpenRouter -> DeepSeek gateway, see /setup/README.md ---
# DEEP_SEEK_API_KEY is the key name issued for the hackathon (see /setup/.env);
# OPENROUTER_API_KEY is what the backend actually reads, falling back to it.
DEEP_SEEK_API_KEY=sk-or-...
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# --- Agentic layer (/carmed) ---
# Cosine floor for serving a stored case as the answer instead of diagnosing
# afresh. Recalibrate whenever EMBEDDING_MODEL_NAME changes -- cosine has no
# absolute meaning across models. Calibrate on held-out examples, not on eval.
CARMED_CACHE_HIT_THRESHOLD=0.80
# Force "do not drive" when the symptom mentions brakes/steering/suspension/airbags.
CARMED_SAFETY_FLOOR=True
CARMED_DEFAULT_CITY=Yerevan
CARMED_CASE_LIMIT=5
# Console level for our own apps.* loggers. INFO shows the agentic trace.
LOG_LEVEL=INFO
